{
  "name": "webway",
  "version": "0.1.0-alpha.0",
  "description": "Webway — deterministic meaning-linking prototype, extracted from MONOLITH",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "dogfood": "node dist/scripts/dogfood.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "webway",
    "meaning-linker",
    "semantic-linking",
    "knowledge-graph"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
